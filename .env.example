# --- Claude (AI drafting, extraction, suggestions, search) ---
ANTHROPIC_API_KEY=

# --- Sessions ---
# Any long random string. Generate one with: openssl rand -hex 32
SESSION_SECRET=

# --- Storage ---
# Where the SQLite database and uploaded files live (created automatically).
DATA_DIR=./data
# Optional: point at a hosted libSQL/Turso database instead of the local file.
# DATABASE_URL=libsql://your-db.turso.io
# DATABASE_AUTH_TOKEN=

# --- Outgoing email (optional; without it staff download a ready .eml to send from Outlook) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Al-Ahmari Gashlan Legal Consulting <info@aglc.sa>"
MAIL_REPLY_TO=info@aglc.sa

# --- Public URL (used in links inside emails) ---
APP_URL=http://localhost:3000

# --- Seed script (npm run seed) ---
SEED_ADMIN_EMAIL=mag@aglc.sa
SEED_ADMIN_PASSWORD=
SEED_STAFF_PASSWORD=
